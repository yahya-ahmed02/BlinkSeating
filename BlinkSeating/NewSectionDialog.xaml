<Window x:Class="BlinkSeating.NewSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Section" Height="320" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock Text="Section name:"/>
        <TextBox x:Name="NameBox" Height="26" Margin="0,2,0,10" Text="SECTION"/>

        <TextBlock Text="Rows:"/>
        <TextBox x:Name="RowsBox" Height="26" Margin="0,2,0,10" Text="1"/>

        <TextBlock Text="Seats per row:"/>
        <TextBox x:Name="ColsBox" Height="26" Margin="0,2,0,10" Text="10"/>

        <TextBlock Text="You can add or remove rows and seats later - this is just a starting point."
                   TextWrapping="Wrap" FontSize="11" Foreground="DimGray" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,6,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Create" Width="70" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
