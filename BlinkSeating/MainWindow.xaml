<Window x:Class="BlinkSeating.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="blink - Seating System" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F3B73" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Add Section" Width="110" Margin="0,0,8,0" Click="AddSection_Click"/>
                <Button Content="Save Layout" Width="100" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Load Layout" Width="100" Margin="0,0,8,0" Click="Load_Click"/>
                <Button Content="New Layout" Width="100" Margin="0,0,8,0" Click="New_Click"/>
                <Button Content="Auto-Seat Zone" Width="120" Margin="20,0,8,0" Background="#F4C542" Click="AutoSeat_Click"/>
                <Separator/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" Padding="8">
            <TextBlock x:Name="StatusText" Text="Available: 0   Assigned: 0   Reserved: 0   Maybe: 0   Blind: 0" FontWeight="Bold"/>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
            <Canvas x:Name="MainCanvas" Width="2400" Height="1600" Background="White"/>
        </ScrollViewer>
    </DockPanel>
</Window>
