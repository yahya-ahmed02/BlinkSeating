<Window x:Class="BlinkSeating.SeatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Seat" Height="310" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="SeatHeader" Text="Section - Row - Seat" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <TextBlock Text="Guest name:"/>
        <TextBox x:Name="GuestNameBox" Height="26" Margin="0,2,0,10"/>

        <TextBlock Text="Status:"/>
        <ComboBox x:Name="StatusBox" Height="26" Margin="0,2,0,10">
            <ComboBoxItem Content="None (regular seat)"/>
            <ComboBoxItem Content="Reserved"/>
            <ComboBoxItem Content="Blind"/>
            <ComboBoxItem Content="Maybe"/>
            <ComboBoxItem Content="Damaged"/>
        </ComboBox>

        <TextBlock Text="Notes:"/>
        <TextBox x:Name="NotesBox" Height="26" Margin="0,2,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Delete Seat" Width="90" Margin="0,0,6,0" Background="#C0392B" Foreground="White" Click="Delete_Click"/>
            <Button Content="Clear Seat" Width="80" Click="Clear_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,6,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Width="70" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
