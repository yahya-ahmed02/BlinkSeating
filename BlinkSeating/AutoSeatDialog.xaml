<Window x:Class="BlinkSeating.AutoSeatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-Seat a Zone" Height="440" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock Text="Zone:" FontWeight="Bold"/>
        <ComboBox x:Name="ZoneBox" Height="26" Margin="0,2,0,12"/>

        <TextBlock Text="Top-priority family sizes (rank order, comma-separated):" TextWrapping="Wrap"/>
        <TextBlock Text="e.g. 2,3,3,4,5,2,3,1,2,8" FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
        <TextBox x:Name="TopSizesBox" Height="26" Margin="0,0,0,12"/>

        <TextBlock Text="Other family sizes (booking order, comma-separated):" TextWrapping="Wrap"/>
        <TextBlock Text="e.g. 3,4,2,1,7,4,9,2,5,7" FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
        <TextBox x:Name="OtherSizesBox" Height="26" Margin="0,0,0,12"/>

        <TextBlock Text="Rows are treated front-to-back in the order they appear in the zone (ROW1 = front). Manually-seated seats are never overwritten."
                   TextWrapping="Wrap" FontSize="11" Foreground="DimGray" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Run Auto-Seat" Width="120" IsDefault="True" Click="Run_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
