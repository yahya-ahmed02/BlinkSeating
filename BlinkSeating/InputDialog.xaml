<Window x:Class="BlinkSeating.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="150" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock x:Name="PromptText" Text="Enter value:" Margin="0,0,0,6"/>
        <TextBox x:Name="ValueBox" Height="26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,6,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="OK" Width="70" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
